{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["policyId", "effectiveFrom", "expiresAt", "accounts", "platforms", "allowed", "limits", "exclusions", "escalation"],
  "properties": {
    "policyId": {"type": "string"},
    "effectiveFrom": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "accounts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed": {"type": "object", "required": ["actions"], "properties": {"actions": {"type": "array", "items": {"enum": ["reply_comment", "set_comment_status", "create_schedule", "update_schedule"]}}}},
    "limits": {"type": "object", "required": ["maxPerHour", "maxPerDay"], "properties": {"maxPerHour": {"type":"integer", "minimum": 0}, "maxPerDay": {"type":"integer", "minimum": 0}}},
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "escalation": {"type": "string"}
  },
  "additionalProperties": false
}
